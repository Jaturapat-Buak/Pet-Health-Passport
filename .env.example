# Docker Compose reads these values from a local .env file when present.
POSTGRES_DB=pet_health_passport
POSTGRES_USER=petpass
POSTGRES_PASSWORD=change_me
RABBITMQ_USER=petpass
RABBITMQ_PASSWORD=replace_with_a_unique_random_password
SMTP_FROM=Pet Health Passport <no-reply@pet-health.local>
NOTIFICATION_LEAD_MINUTES=1440
JWT_SECRET=replace_with_a_long_random_secret
BACKEND_PORT=5000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MAILPIT_PORT=8025
RABBITMQ_MANAGEMENT_PORT=15672

